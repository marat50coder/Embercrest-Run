#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Dart AOT name-stripping for App Store / TestFlight archives.
// flutter run --release still needs --obfuscate; Codemagic passes it too.
DART_OBFUSCATION=true
SPLIT_DEBUG_INFO=$(SRCROOT)/../build/debug_info
